# Copy to .env.local and fill in. Never commit real keys.
# With no keys set, the app runs in labeled demo mode (built-in examples only).

# Provider order to try. Only providers with a key are used.
AI_PROVIDERS=gemini,openai_compatible

# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key
# Confirm the current model ID in Google's docs before a demo.
GEMINI_MODEL=gemini-2.5-flash

# Any OpenAI-compatible chat completions API (OpenAI, OpenRouter, Groq, ...)
OPENAI_COMPAT_API_KEY=your-openai-compatible-api-key
OPENAI_COMPAT_BASE_URL=https://api.openai.com/v1
OPENAI_COMPAT_MODEL=your-model-id
