# Copy to .env.local and fill in. Never commit real keys.
# With no keys set, the app runs in labeled demo mode (built-in examples only).

# Provider order to try. Only providers with a key are used.
AI_PROVIDERS=gemini,openai_compatible

# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key
# gemini-2.5-flash is closed to new users. Confirm the model ID before a demo.
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional. Sent as thinkingConfig.thinkingLevel only when set (Gemini 3 models).
GEMINI_THINKING_LEVEL=minimal

# Any OpenAI-compatible chat completions API (Paper Instruments, OpenAI, OpenRouter, Groq, ...)
# Paper Instruments: base URL https://api.paperinstruments.com/v1, model ultramarine-1-flash
OPENAI_COMPAT_API_KEY=your-openai-compatible-api-key
OPENAI_COMPAT_BASE_URL=https://api.paperinstruments.com/v1
OPENAI_COMPAT_MODEL=ultramarine-1-flash
# Optional. Sent as reasoning_effort only when set. Ultramarine defaults to "max",
# which is too slow for the 12s per-attempt timeout, so use "low".
OPENAI_COMPAT_REASONING_EFFORT=low
